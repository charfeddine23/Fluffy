<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Outer glass drop shadow -->
    <path
        android:pathData="M27,27 h46 a12,12 0 0,1 12,12 v46 a12,12 0 0,1 -12,12 h-46 a12,12 0 0,1 -12,-12 v-46 a12,12 0 0,1 12,-12 z"
        android:fillColor="#33000000" />

    <!-- Chromatic Dispersion Refraction Rim (Iridescent Prism Border) -->
    <path
        android:pathData="M26,25 h48 a14,14 0 0,1 14,14 v48 a14,14 0 0,1 -14,14 h-48 a14,14 0 0,1 -14,-14 v-48 a14,14 0 0,1 14,-14 z"
        android:strokeWidth="1.8">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="12"
                android:startY="12"
                android:endX="96"
                android:endY="96"
                android:type="linear">
                <item android:offset="0.0" android:color="#CC38BDF8" />
                <item android:offset="0.3" android:color="#E6C084FC" />
                <item android:offset="0.6" android:color="#E6F472B6" />
                <item android:offset="1.0" android:color="#8022D3EE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Frosted Glass Card Body (Translucent Liquid Surface) -->
    <path
        android:pathData="M26,25 h48 a14,14 0 0,1 14,14 v48 a14,14 0 0,1 -14,14 h-48 a14,14 0 0,1 -14,-14 v-48 a14,14 0 0,1 14,-14 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="26"
                android:startY="20"
                android:endX="78"
                android:endY="90"
                android:type="linear">
                <item android:offset="0.0" android:color="#4DFFFFFF" />
                <item android:offset="0.4" android:color="#26FFFFFF" />
                <item android:offset="1.0" android:color="#1AFFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Specular Highlight / Inner Shadow -->
    <path
        android:pathData="M28,27 h44 a11,11 0 0,1 11,11"
        android:strokeWidth="1.2"
        android:strokeColor="#80FFFFFF" />

    <!-- Frosted Note Header Line with Iridescent Gradient -->
    <path
        android:pathData="M34,39 h24"
        android:strokeWidth="3.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="34"
                android:startY="39"
                android:endX="58"
                android:endY="39"
                android:type="linear">
                <item android:offset="0.0" android:color="#38BDF8" />
                <item android:offset="1.0" android:color="#C084FC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Note Content Lines -->
    <path
        android:pathData="M34,48 h38"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeColor="#70FFFFFF" />
    <path
        android:pathData="M34,56 h30"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeColor="#50FFFFFF" />

    <!-- Checklist / Sparkle accent in corner -->
    <path
        android:pathData="M34,65 h18"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeColor="#40FFFFFF" />

    <!-- Fluffy Liquid Star Sparkle -->
    <path
        android:pathData="M66,66 Q71,66 71,61 Q71,66 76,66 Q71,66 71,71 Q71,66 66,66 Z"
        android:fillColor="#F472B6" />
    <path
        android:pathData="M62,40 Q65,40 65,37 Q65,40 68,40 Q65,40 65,43 Q65,40 62,40 Z"
        android:fillColor="#38BDF8" />
</vector>
