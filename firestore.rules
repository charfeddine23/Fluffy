rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Per-user Notes synced from Fluffy
    match /users/{userId}/notes/{noteId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.content is string
        && request.resource.data.updatedAt is int;
    }

    // Per-user App Settings Snapshot
    match /users/{userId}/settings/{docId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(userId);
    }

    // Per-user Vault Items (Readable, creatable, editable, and deletable strictly by owner)
    match /users/{userId}/vault/{vaultId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == request.auth.uid;
    }

    // Scanner Local-Only Policy:
    // Scanned documents, pages, PDFs, and signatures MUST remain strictly on-device and never sync to cloud DB.
    match /users/{userId}/scanner/{document=**} {
      allow read, write: if false;
    }
    match /users/{userId}/scanned_documents/{document=**} {
      allow read, write: if false;
    }
  }
}
